{
  "name": "delivery-problem-credit-processor",
  "checks": [
    {
      "id": "install-node-dependencies",
      "command": ["pnpm", "install", "--frozen-lockfile"],
      "timeout_seconds": 600,
      "required": true
    },
    {
      "id": "delivery-problem-credit-processor-test-and-assembly",
      "command": ["sbt", "project delivery-problem-credit-processor", "test", "assembly"],
      "timeout_seconds": 1800,
      "required": true
    },
    {
      "id": "cdk-package",
      "command": ["pnpm", "--filter", "cdk", "package"],
      "timeout_seconds": 1800,
      "required": true
    },
    {
      "id": "diff-check",
      "command": ["git", "diff", "--check"],
      "timeout_seconds": 60,
      "required": true
    }
  ],
  "required_observations": [
    "local-validation",
    "configuration",
    "code-deployment",
    "functional-test",
    "review-readiness",
    "review",
    "monitoring",
    "rollback"
  ]
}
