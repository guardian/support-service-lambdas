{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"moduleResolution": "Node16",
		"rootDir": "..",
		"types": ["node", "jest"],
		"lib": ["ES2020"],
		"declaration": true,
		"skipLibCheck": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
		"noImplicitThis": true,
		"alwaysStrict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": false,
		"inlineSourceMap": true,
		"inlineSources": true,
		"experimentalDecorators": true,
		"strictPropertyInitialization": false,
		"outDir": "dist",
		// so this package can import handler code that uses the @modules aliases
		"paths": { "@modules/*": ["../modules/*"] }
	},
	"include": ["lib/**/*", "bin/**/*"],
	"exclude": ["node_modules", "cdk.out", "lib/**/__snapshots__/**"]
}
