                },
                ":alarms-handler-topic-CODE",
              ],
            ],
          },
        ],
        "AlarmDescription": {
          "Fn::Join": [
            "",
            [
              "There is one or more event in the salesforce-event-bus dead letter queue (DLQ). Check the attributes of the failed message(s) for details of the error and check that the rule corresponding to the failed message is correctly configured.
DLQ: https://",
              {
                "Ref": "AWS::Region",
              },
              ".console.aws.amazon.com/sqs/v2/home?region=",
              {
                "Ref": "AWS::Region",
              },
              "#/queues/https%3A%2F%2Fsqs.",
              {
                "Ref": "AWS::Region",
              },
              ".amazonaws.com%2F",
              {
                "Ref": "AWS::AccountId",
              },
              "%2F",
              {
                "Fn::GetAtt": [
                  "deadletterssalesforceeventbusqueue29BFA779",
                  "QueueName",
                ],
              },
            ],
          ],
        },
        "AlarmName": "An event for CODE salesforce-event-bus was not processed",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "deadletterssalesforceeventbusqueue29BFA779",
                "QueueName",
              ],
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Namespace": "AWS/SQS",
        "Period": 300,
        "Statistic": "Maximum",
        "Tags": [
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/support-service-lambdas",
          },
          {
            "Key": "Stack",
            "Value": "membership",
          },
          {
            "Key": "Stage",
            "Value": "CODE",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "ignore",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SalesforceOutboundQueuePolicy": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "sqs:SendMessage",
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "SfBusToContactUpdateQueue75131C06",
                      "Arn",
                    ],
                  },
                },
              },
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com",
              },
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:sqs:",
                    {
                      "Ref": "AWS::Region",
                    },
                    ":",
                    {
                      "Ref": "AWS::AccountId",
                    },
                    ":salesforce-outbound-messages-CODE",
                  ],
                ],
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Queues": [
          {
            "Fn::Join": [
              "",
              [
                "https://sqs.",
                {
                  "Ref": "AWS::Region",
                },
                ".",
                {
                  "Ref": "AWS::URLSuffix",
                },
                "/",
                {
                  "Ref": "AWS::AccountId",
                },
                "/salesforce-outbound-messages-CODE",
              ],
            ],
          },
        ],
      },
      "Type": "AWS::SQS::QueuePolicy",
    },
    "SfBusToCancellationsBus949E00F8": {
      "Properties": {
        "Description": "Forward SF Subscription Cancellation platform events from the SF bus to the cancellations-bus",
        "EventBusName": "aws.partner/salesforce.com/00D9E0000004jvhUAA/0YLUD00000008Ll4AI",
        "EventPattern": {
          "detail-type": [
            "Subscription_Cancellation__e",
          ],
          "source": [
            {
              "prefix": "aws.partner/salesforce.com",
            },
          ],
        },
        "State": "ENABLED",
        "Tags": [
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/support-service-lambdas",
          },
          {
            "Key": "Stack",
            "Value": "membership",
          },
          {
            "Key": "Stage",
            "Value": "CODE",
          },
        ],
        "Targets": [
          {
            "Arn": {
              "Fn::ImportValue": "cancellations-bus-CODE-arn",
            },
            "DeadLetterConfig": {
              "Arn": {
                "Fn::GetAtt": [
                  "deadletterssalesforceeventbusqueue29BFA779",
