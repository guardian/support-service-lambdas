    "StateMachine2E01A3A5": {
      "DeletionPolicy": "Delete",
      "DependsOn": [
        "StateMachineRoleDefaultPolicyDF1E6607",
        "StateMachineRoleB840431D",
      ],
      "Properties": {
        "DefinitionString": {
          "Fn::Join": [
            "",
            [
              "{"StartAt":"QueryZuora","States":{"QueryZuora":{"Next":"WaitForZuora","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2}],"Type":"Task","Resource":"",
              {
                "Fn::GetAtt": [
                  "QueryLambda54767050",
                  "Arn",
                ],
              },
              ""},"WaitForZuora":{"Type":"Wait","Seconds":30,"Next":"FetchResults"},"FetchResults":{"Next":"CheckForSubscriptions","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["QueryNotCompleteError"],"IntervalSeconds":60,"MaxAttempts":20,"BackoffRate":1}],"Type":"Task","Resource":"",
              {
                "Fn::GetAtt": [
                  "FetchLambdaB01E6941",
                  "Arn",
                ],
              },
              ""},"CheckForSubscriptions":{"Type":"Choice","Choices":[{"Variable":"$.count","NumericEquals":0,"Next":"NoSubscriptionsFound"}],"Default":"ProcessSubscriptions"},"ProcessSubscriptions":{"Type":"Map","Comment":"MaxConcurrency limits concurrent Zuora requests. Failures are tolerated so one subscription does not stop the rest; they fail the execution afterwards","ResultPath":"$.map","Next":"GetMapResult","ItemSelector":{"subscriptionNumber.$":"$$.Map.Item.Value.subscriptionNumber","accountNumber.$":"$$.Map.Item.Value.accountNumber","billingDate.$":"$.billingDate"},"ItemProcessor":{"ProcessorConfig":{"Mode":"DISTRIBUTED","ExecutionType":"EXPRESS"},"StartAt":"ProcessSubscription","States":{"ProcessSubscription":{"End":true,"Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["States.ALL"],"IntervalSeconds":10,"MaxAttempts":2,"BackoffRate":2}],"Type":"Task","Resource":"",
              {
                "Fn::GetAtt": [
                  "ProcessorLambda71A929CE",
                  "Arn",
                ],
              },
              ""}}},"MaxConcurrency":10,"ItemReader":{"Resource":"arn:",
              {
                "Ref": "AWS::Partition",
              },
              ":states:::s3:getObject","ReaderConfig":{"InputType":"JSON"},"Parameters":{"Bucket":"",
              {
                "Ref": "Bucket83908E77",
              },
              "","Key.$":"$.key"}},"ToleratedFailurePercentage":100,"ResultWriter":{"Resource":"arn:",
              {
                "Ref": "AWS::Partition",
              },
              ":states:::s3:putObject","Parameters":{"Bucket":"",
              {
                "Ref": "Bucket83908E77",
              },
              "","Prefix.$":"States.Format('{}/results', $.billingDate)"}}},"GetMapResult":{"Next":"CheckForFailures","Type":"Task","Resource":"arn:aws:states:::aws-sdk:s3:getObject","Parameters":{"Bucket.$":"$.map.ResultWriterDetails.Bucket","Key.$":"$.map.ResultWriterDetails.Key"},"ResultSelector":{"Payload.$":"States.StringToJson($.Body)"},"OutputPath":"$.Payload"},"CheckForFailures":{"Type":"Choice","Choices":[{"Variable":"$.ResultFiles.FAILED[0]","IsPresent":true,"Next":"SomeSubscriptionsFailed"}],"Default":"AllSubscriptionsProcessed"},"AllSubscriptionsProcessed":{"Type":"Succeed"},"SomeSubscriptionsFailed":{"Type":"Fail","Cause":"Some subscriptions could not be processed, see the FAILED results file in S3"},"NoSubscriptionsFound":{"Type":"Fail","Cause":"The Zuora query found no subscriptions billing on the date"}},"TimeoutSeconds":10800}",
            ],
          ],
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "StateMachineRoleB840431D",
            "Arn",
          ],
        },
        "StateMachineName": "email-reminders-PROD",
        "Tags": [
          {
            "Key": "App",
            "Value": "email-reminders",
          },
          {
            "Key": "gu:cdk:version",
            "Value": "TEST",
          },
