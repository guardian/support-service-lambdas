            [
              "{"StartAt":"Refund due?","States":{"Refund due?":{"Type":"Choice","Choices":[{"Condition":"{% $states.input.refundDue = true %}","Next":"GenerateCancellationInvoice"}],"Default":"CheckPaymentSettlement"},"CheckPaymentSettlement":{"Next":"Payment?","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["States.ALL"],"IntervalSeconds":3600,"MaxAttempts":5,"BackoffRate":2}],"Type":"Task","Output":"{% $merge([$states.input, $states.result]) %}","Resource":"",
              {
                "Fn::GetAtt": [
                  "CheckPaymentSettlementLambda20602FE6",
                  "Arn",
                ],
              },
              ""},"Wait 24h":{"Type":"Wait","Seconds":86400,"Next":"CheckPaymentSettlement"},"Payment?":{"Type":"Choice","Choices":[{"Condition":"{% $states.input.status = \\"Pending\\" %}","Next":"Wait 24h"},{"Condition":"{% $states.input.status = \\"Failed\\" %}","Next":"GetCancellationReason"},{"Condition":"{% $states.input.status = \\"Settled\\" and $states.input.refundDue = true %}","Next":"CreateRefund"}],"Default":"Succeed"},"Succeed":{"Type":"Succeed"},"SendPaymentFailedEmail":{"Next":"Succeed","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["States.ALL"],"IntervalSeconds":3600,"MaxAttempts":5,"BackoffRate":2}],"Type":"Task","Output":"{% $merge([$states.input, $states.result]) %}","Resource":"",
              {
                "Fn::GetAtt": [
                  "SendPaymentFailedEmailLambdaA7794EF0",
                  "Arn",
                ],
              },
              ""},"Backdated?":{"Type":"Choice","Choices":[{"Condition":"{% $states.input.backdated = true %}","Next":"SendPaymentFailedEmail"}],"Default":"Succeed"},"BalanceInvoices":{"Next":"Backdated?","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["States.ALL"],"IntervalSeconds":3600,"MaxAttempts":5,"BackoffRate":2}],"Type":"Task","Output":"{% $merge([$states.input, $states.result]) %}","Resource":"",
              {
                "Fn::GetAtt": [
                  "BalanceInvoicesLambdaB82C6F3B",
                  "Arn",
                ],
              },
              ""},"CalculateCredit":{"Next":"BalanceInvoices","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["States.ALL"],"IntervalSeconds":3600,"MaxAttempts":5,"BackoffRate":2}],"Type":"Task","Output":"{% $merge([$states.input, $states.result]) %}","Resource":"",
              {
                "Fn::GetAtt": [
                  "CalculateRefundLambda0081A960",
                  "Arn",
                ],
              },
              ""},"BackdateCancellation":{"Next":"CalculateCredit","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["States.ALL"],"IntervalSeconds":3600,"MaxAttempts":5,"BackoffRate":2}],"Type":"Task","Output":"{% $merge([$states.input, $states.result]) %}","Resource":"",
              {
                "Fn::GetAtt": [
                  "BackdateCancellationLambdaF9568FC2",
                  "Arn",
                ],
              },
              ""},"GetCancellationReason":{"Next":"BackdateCancellation","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2},{"ErrorEquals":["States.ALL"],"IntervalSeconds":3600,"MaxAttempts":5,"BackoffRate":2}],"Type":"Task","Output":"{% $merge([$states.input, $states.result]) %}","Resource":"",
              {
