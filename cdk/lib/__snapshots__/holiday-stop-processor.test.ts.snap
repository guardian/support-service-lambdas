            "Value": "guardian/support-service-lambdas",
          },
          {
            "Key": "Stack",
            "Value": "membership",
          },
          {
            "Key": "Stage",
            "Value": "CODE",
          },
        ],
        "Timeout": 900,
      },
      "Type": "AWS::Lambda::Function",
    },
    "HolidayStopProcessorLambdaInvokeConfig": {
      "Properties": {
        "FunctionName": {
          "Ref": "HolidayStopProcessor",
        },
