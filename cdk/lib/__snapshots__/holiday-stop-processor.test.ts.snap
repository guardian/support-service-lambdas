{
  "Metadata": {
    "gu:cdk:constructs": [
      "GuDistributionBucketParameter",
    ],
    "gu:cdk:version": "TEST",
  },
  "Parameters": {
    "DistributionBucketName": {
      "Default": "/account/services/artifact.bucket",
      "Description": "SSM parameter containing the S3 bucket name holding distribution artifacts",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "HolidayStopProcessor": {
      "DependsOn": [
        "HolidayStopProcessorPolicy",
        "HolidayStopProcessorRole",
      ],
      "Properties": {
        "Architectures": [
          "arm64",
        ],
        "Code": {
          "S3Bucket": {
            "Ref": "DistributionBucketName",
          },
          "S3Key": "membership/CODE/holiday-stop-processor/holiday-stop-processor.jar",
        },
        "Description": "Updates subscriptions with outstanding holiday stops. Source - https://github.com/guardian/support-service-lambdas/tree/main/handlers/holiday-stop-processor",
        "Environment": {
          "Variables": {
            "APP": "holiday-stop-processor",
            "NODE_OPTIONS": "--enable-source-maps",
            "STACK": "membership",
