            "Stage": "CODE",
          },
        },
        "FunctionName": "holiday-stop-processor-CODE",
        "Handler": "com.gu.holidaystopprocessor.Handler::handle",
        "LoggingConfig": {
          "LogFormat": "Text",
        },
        "MemorySize": 1232,
        "Role": {
          "Fn::GetAtt": [
            "HolidayStopProcessorRole",
            "Arn",
          ],
        },
        "Runtime": "java21",
