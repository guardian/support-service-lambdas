{
  "name": "cancellation-api",
  "scripts": {
    "test": "jest --group=-integration",
    "it-test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --group=integration",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache --cache-location /tmp/eslintcache/ 'src/**/*.ts' 'test/**/*.ts'",
    "check-formatting": "prettier --check \"**/*.ts\"",
    "fix-formatting": "prettier --write \"**/*.ts\"",
    "build": "esbuild --bundle --platform=node --target=node22 --outdir=target/ --outbase=src src/cancel/index.ts src/refund/handlers/*.ts --sourcemap --source-root=/support-service-lambdas/handlers/cancellation-api/target/",
    "package": "pnpm type-check && pnpm lint && pnpm check-formatting && pnpm test && pnpm packageQuick",
    "packageQuick": "pnpm build && cd target && zip -qr cancellation-api.zip . -i '*.js' '*.js.map'",
    "cdk:test": "pnpm --filter cdk test cancellation-api",
    "cdk:test-update": "pnpm --filter cdk test-update cancellation-api",
    "update-lambda": "../../update-lambda.sh \"cancellation-api\" cancellation-api- cancellation-api-refund-generate-cancellation-invoice- cancellation-api-refund-calculate-refund- cancellation-api-refund-check-payment-settlement- cancellation-api-refund-create-refund- cancellation-api-refund-balance-invoices- cancellation-api-refund-get-cancellation-reason- cancellation-api-refund-backdate-cancellation- cancellation-api-refund-send-payment-failed-email-",
    "update-stack": "../../update-stack.sh \"cancellation-api\"",
    "local": "tsx runLocal/server.ts"
  },
  "NOTICE1": "MANAGED FILE: to push changes see buildcheck/README.md - template: buildcheck/data/templates/handler/package.json.ts",
  "NOTICE2": "all dependencies are defined in buildcheck/data/build.ts",
  "dependencies": {
    "zod": "catalog:",
    "dayjs": "^1.11.13",
    "hono": "^4.13.18",
    "@hono/zod-openapi": "^1.6.3",
    "email": "workspace:*",
    "logger": "workspace:*",
    "routing": "workspace:*",
    "identity": "workspace:*",
    "zuora": "workspace:*",
    "guardian-subscription": "workspace:*",
    "product-catalog": "workspace:*",
    "zuora-catalog": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "tsx": "^4.21.0"
  }
}
