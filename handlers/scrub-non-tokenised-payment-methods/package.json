{
  "name": "scrub-non-tokenised-payment-methods",
  "scripts": {
    "test": "jest --group=-integration",
    "it-test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --group=integration",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache --cache-location /tmp/eslintcache/ 'src/**/*.ts' 'test/**/*.ts'",
    "check-formatting": "prettier --check \"**/*.ts\"",
    "fix-formatting": "prettier --write \"**/*.ts\"",
    "build": "esbuild --bundle --platform=node --target=node22 --outdir=target/ src/handlers/*.ts --sourcemap --source-root=/support-service-lambdas/handlers/scrub-non-tokenised-payment-methods/target/",
    "package": "pnpm type-check && pnpm lint && pnpm check-formatting && pnpm test && pnpm packageQuick",
    "packageQuick": "pnpm build && cd target && zip -qr scrub-non-tokenised-payment-methods.zip ./*.js.map ./*.js",
    "cdk:test": "pnpm --filter cdk test scrub-non-tokenised-payment-methods",
    "cdk:test-update": "pnpm --filter cdk test-update scrub-non-tokenised-payment-methods",
    "update-lambda": "../../update-lambda.sh \"scrub-non-tokenised-payment-methods\" scrub-non-tokenised-payment-methods-get- scrub-non-tokenised-payment-methods-scrub-",
    "update-stack": "../../update-stack.sh \"scrub-non-tokenised-payment-methods\""
  },
  "NOTICE1": "MANAGED FILE: to push changes see buildcheck/README.md - template: buildcheck/data/templates/handler/package.json.ts",
  "NOTICE2": "all dependencies are defined in buildcheck/data/build.ts",
  "dependencies": {
    "aws": "workspace:*",
    "bigquery": "workspace:*",
    "zuora": "workspace:*"
  }
}
